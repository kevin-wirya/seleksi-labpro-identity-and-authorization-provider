// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus{
  active 
  inactive
}

enum ApplicationStatus{
  active
  inactive
}

enum SessionStatus{
  active
  expired
  revoked
}

enum EventStatus{
  pending
  processing
  succeeded
  retrying
  failed
}

model User{
  id String @id @default(uuid())
  name String 
  email String @unique
  password_hash String
  status UserStatus @default(inactive)
  mfa_enabled Boolean @default(false)
  mfa_secret String?
  mfa_recovery_codes String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  user_groups UserGroup[]
  sso_sessions SsoSession[]
  authorization_codes AuthorizationCode[]
  access_tokens AccessToken[]
  mfa_pending_sessions MfaPendingSession[]
  @@map("users")
}

model MfaPendingSession{
  id String @id @default(uuid())
  user_id String
  token String @unique
  expires_at DateTime
  created_at DateTime @default(now())
  user User @relation(fields:[user_id],references:[id],onDelete:Cascade)
  @@map("mfa_pending_sessions")
}

model Group{
  id String @id @default(uuid())
  name String @unique
  description String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  user_groups UserGroup[]
  group_policies ApplicationGroupPolicy[]
  @@map("groups")
}

model UserGroup{
  id String @id @default(uuid())
  user_id String
  group_id String
  created_at DateTime @default(now())
  user User @relation(fields:[user_id],references:[id],onDelete:Cascade)
  group Group @relation(fields:[group_id],references:[id],onDelete:Cascade)
  @@unique([user_id,group_id])
  @@map("user_groups")
}

model Application{
  id String @id @default(uuid())
  name String
  client_id String @unique
  client_secret_hash String?
  status ApplicationStatus @default(inactive)
  launch_url String?
  logout_notification_url String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  redirect_uris ApplicationRedirectUri[]
  group_policies ApplicationGroupPolicy[]
  authorization_codes AuthorizationCode[]
  access_tokens AccessToken[]
  @@map("applications")
}

model ApplicationRedirectUri{
  id String @id @default(uuid())
  application_id String
  redirect_uri String
  created_at DateTime @default(now())
  application Application @relation(fields:[application_id],references:[id],onDelete:Cascade)
  @@map("application_redirect_uris")
}

model ApplicationGroupPolicy{
  id String @id @default(uuid())
  application_id String
  group_id String
  effect String @default("allow")
  created_at DateTime @default(now())
  application Application @relation(fields:[application_id],references:[id],onDelete:Cascade)
  group Group @relation(fields:[group_id],references:[id],onDelete:Cascade)
  @@unique([application_id,group_id,effect])
  @@map("application_group_policies")
}

model SsoSession{
  id String @id @default(uuid())
  user_id String
  session_token_hash String
  status SessionStatus @default(active)
  created_at DateTime @default(now())
  expires_at DateTime
  last_activity_at DateTime?
  revoked_at DateTime?
  revoke_reason String?
  ip_address String?
  user_agent String?
  user User @relation(fields:[user_id],references:[id],onDelete:Cascade)
  authorization_codes AuthorizationCode[]
  access_tokens AccessToken[]
  @@map("sso_sessions")
}

model AuthorizationCode{
  id String @id @default(uuid())
  code_hash String
  user_id String
  application_id String
  sso_session_id String
  redirect_uri String
  created_at DateTime @default(now())
  expires_at DateTime
  used_at DateTime?
  user User @relation(fields:[user_id],references:[id],onDelete:Cascade)
  application Application @relation(fields:[application_id],references:[id],onDelete:Cascade)
  sso_session SsoSession @relation(fields:[sso_session_id],references:[id],onDelete:Cascade)
  @@map("authorization_codes")
}

model AccessToken{
  id String @id @default(uuid())
  token_hash String
  user_id String
  application_id String
  sso_session_id String
  scopes String?
  status SessionStatus @default(active)
  issued_at DateTime @default(now())
  expires_at DateTime
  revoked_at DateTime?
  user User @relation(fields:[user_id],references:[id],onDelete:Cascade)
  application Application @relation(fields:[application_id],references:[id],onDelete:Cascade)
  sso_session SsoSession @relation(fields:[sso_session_id],references:[id],onDelete:Cascade)
  @@map("access_tokens")
}

model AuditLog{
  id String @id @default(uuid())
  event_type String
  actor_id String?
  user_id String?
  application_id String?
  session_id String?
  result String
  metadata String?
  ip_address String?
  created_at DateTime @default(now())
  @@map("audit_logs")
}

model LocalSession{
  id String @id @default(uuid())
  session_token_hash String
  external_user_id String
  central_session_id String
  application_id String
  status SessionStatus @default(active)
  created_at DateTime @default(now())
  expires_at DateTime
  last_activity_at DateTime?
  revoked_at DateTime?
  revoke_reason String?
  @@map("local_sessions")
}

model ProfileCache{
  external_user_id String @id
  name String
  email String
  groups String? // JSON
  synced_at DateTime @default(now())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  @@map("profile_cache")
}

model ProcessedEvent{
  event_id String @id
  event_type String 
  processed_at DateTime @default(now())
  result String
  @@map("processed_events")
}

model Event{
  id String @id @default(uuid())
  event_type String
  user_id String
  central_session_id String?
  application_id String?
  payload String // JSON
  status String @default("pending")
  created_at DateTime @default(now())
  published_at DateTime?
  deliveries EventDelivery[]
  @@map("events")
}

model EventDelivery{
  id String @id @default(uuid())
  event_id String
  application_id String
  status EventStatus @default(pending)
  attempt_count Int @default(0)
  last_attempt_at DateTime?
  next_retry_at DateTime?
  processed_at DateTime?
  last_error String?
  event Event @relation(fields:[event_id],references:[id],onDelete:Cascade)
  @@map("event_deliveries")
}